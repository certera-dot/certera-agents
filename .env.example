# ─────────────────────────────────────────────
#  TRADING AGENT — Variables de entorno
#  Copiar como .env y completar con valores reales
#  NUNCA commitear el archivo .env al repositorio
# ─────────────────────────────────────────────

# ── Binance ──────────────────────────────────
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_TESTNET=true          # cambiar a false solo en producción live

# ── Telegram ─────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Supabase ─────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# ── Anthropic ────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Alpaca (activar en Fase 4) ───────────────
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=true

# ── ROFEX / Primary (activar en Fase 4) ──────
ROFEX_USER=your_rofex_user
ROFEX_PASSWORD=your_rofex_password
ROFEX_ENV=reMarkets             # o primary

# ── Configuración del agente ─────────────────
# OPERATION_MODE:
#   manual → solo alertas Telegram, nunca abre trades (no aprende)
#   auto   → abre trades simulados, los sigue, registra WIN/LOSS → el agente APRENDE
# Para el ciclo de aprendizaje completo usar: auto + SIMULATION_MODE=true
OPERATION_MODE=auto             # manual | semi | auto
SIMULATION_MODE=true            # true hasta tener track record sólido
AGENT_MATURITY_LEVEL=aprendiz   # aprendiz | en_formacion | calibrado | paper_ready | live_ready

# ── Risk Manager (no modificar sin análisis) ─
RISK_PER_TRADE_PCT=1.0          # % del capital por operación
STOP_LOSS_MAX_PCT=2.0           # stop máximo permitido
POSITION_SIZE_MAX_PCT=10.0      # tamaño máximo de posición
DRAWDOWN_MAX_PCT=15.0           # pausa automática al alcanzar
DAILY_LOSS_LIMIT_PCT=5.0        # detención completa del día

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LOG_TO_FILE=true

# ── Forex (CCXT) ──────────────────────────────
# Dejá vacío para usar datos públicos (currencycom)
# Para cuenta real/demo: oanda, alpaca, etc.
FOREX_EXCHANGE=
FOREX_API_KEY=
FOREX_API_SECRET=
